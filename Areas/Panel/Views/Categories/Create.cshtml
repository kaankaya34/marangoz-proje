@model Category
@{
    ViewData["Title"] = "Yeni Kategori";
}
<h1 class="mb-3">Yeni Kategori</h1>
<div class="wood-card p-4" style="max-width: 600px">
    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Örn: Sallanan Sandalye" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <button class="btn btn-wood" type="submit">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-wood">Vazgeç</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
