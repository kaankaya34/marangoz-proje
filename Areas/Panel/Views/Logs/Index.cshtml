@model LogListViewModel
@{
    ViewData["Title"] = "Admin Log Sayfası";
    string? PageUrl(int p) => Url.Action("Index", "Logs", new { area = "Panel", logAction = Model.Action, q = Model.Query, page = p });
}
<h1 class="mb-1">Admin Log Sayfası</h1>
<p class="text-muted">Kim, neyi, ne zaman yaptı? Ürün ekleme, teklif durumu güncelleme, kullanıcı işlemleri ve girişler burada kayıt altındadır.</p>

<form method="get" class="wood-card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-5"><input class="form-control" name="q" value="@Model.Query" placeholder="Kullanıcı veya detay ara..." /></div>
        <div class="col-md-4">
            <select class="form-select" name="logAction">
                <option value="">Tüm işlemler</option>
                @foreach (var a in Model.Actions)
                {
                    <option value="@a" selected="@(Model.Action == a)">@a</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid"><button class="btn btn-dark-wood">Filtrele</button></div>
    </div>
</form>

<div class="wood-card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Tarih / Saat</th><th>Kullanıcı</th><th>Rol</th><th>İşlem</th><th>Detay</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap small">@l.CreatedAt.ToLocalTr().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="fw-semibold">@l.UserName</td>
                        <td class="small">@(string.IsNullOrEmpty(l.UserRole) ? "-" : Roles.DisplayName(l.UserRole))</td>
                        <td><span class="ai-chip">@l.Action</span></td>
                        <td class="small">@l.Details</td>
                    </tr>
                }
                @if (!Model.Items.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Kayıt yok.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="(Model.Page, Model.TotalPages, (Func<int, string?>)PageUrl)" />
