@model ProductFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Ürünü Düzenle" : "Yeni Ürün";
}
<h1 class="mb-3">@ViewData["Title"]</h1>
<div class="wood-card p-4" style="max-width: 800px">
    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? (int?)Model.Id : null)" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.CategoryId))">
                    <option value="0">Seçin...</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Material" class="form-label"></label>
                <input asp-for="Material" class="form-control" placeholder="Meşe, ceviz, kayın..." />
                <span asp-validation-for="Material" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Dimensions" class="form-label"></label>
                <input asp-for="Dimensions" class="form-control" placeholder="180x90x75 cm" />
                <span asp-validation-for="Dimensions" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Image" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ExistingImageUrl" alt="Mevcut görsel" style="max-height:120px;border-radius:8px" />
                        <div class="form-check mt-1">
                            <input type="checkbox" class="form-check-input" id="RemoveMainImage" name="RemoveMainImage" value="true" />
                            <label class="form-check-label small" for="RemoveMainImage">Ana görseli kaldır</label>
                        </div>
                    </div>
                }
                <input asp-for="Image" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="GalleryImages" class="form-label"></label>
                @if (Model.ExistingGallery.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-3 mb-2">
                        @foreach (var g in Model.ExistingGallery)
                        {
                            <div class="text-center small">
                                <img src="@g.Url" alt="Galeri görseli" style="width:90px;height:90px;object-fit:cover;border-radius:8px" />
                                <div class="form-check d-flex justify-content-center gap-1 mt-1">
                                    <input type="checkbox" class="form-check-input" id="rm-@g.Id" name="RemoveImageIds" value="@g.Id" />
                                    <label class="form-check-label" for="rm-@g.Id">Sil</label>
                                </div>
                            </div>
                        }
                    </div>
                }
                <input asp-for="GalleryImages" class="form-control" type="file" multiple accept="image/jpeg,image/png,image/webp" />
                <span asp-validation-for="GalleryImages" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-wood" type="submit">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-wood">Vazgeç</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
