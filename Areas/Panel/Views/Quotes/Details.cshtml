@model QuoteRequest
@{
    ViewData["Title"] = $"Teklif #{Model.Id}";
}
<a asp-action="Index" class="small">← Listeye dön</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-2 mb-3">
    <div>
        <h1 class="mb-1">#@Model.Id · @Model.Title</h1>
        <div class="small text-muted">Oluşturulma: @Model.CreatedAt.ToTrString()@(Model.UpdatedAt.HasValue ? " · Son güncelleme: " + Model.UpdatedAt.Value.ToTrString() : "")</div>
    </div>
    <partial name="_StatusBadge" model="Model.Status" />
</div>

<div class="wood-card p-3 mb-4">
    <div class="small text-muted mb-2">Durumu güncelle (tek tıkla):</div>
    <partial name="_StatusButtons" model="Model" />
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="wood-card p-4">
            <h5>Talep</h5>
            <p style="white-space: pre-line">@Model.Description</p>
            <dl class="row mb-0">
                @if (Model.Product is not null) { <dt class="col-sm-4">İlgili Ürün</dt><dd class="col-sm-8">@Model.Product.Name</dd> }
                @if (!string.IsNullOrWhiteSpace(Model.CustomDimensions)) { <dt class="col-sm-4">İstenen Ölçüler</dt><dd class="col-sm-8">@Model.CustomDimensions</dd> }
                @if (Model.Budget.HasValue) { <dt class="col-sm-4">Bütçe</dt><dd class="col-sm-8">@Model.Budget.Value.ToString("N0") ₺</dd> }
            </dl>
            @if (Model.Attachments.Any())
            {
                <hr />
                <div class="small text-muted mb-2">Müşterinin yüklediği fotoğraflar / krokiler</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var a in Model.Attachments)
                    {
                        <a href="@a.Url" target="_blank" rel="noopener"><img src="@a.Url" alt="Referans fotoğraf" loading="lazy" style="width:110px;height:110px;object-fit:cover;border-radius:8px" /></a>
                    }
                </div>
            }
        </div>

        <div class="wood-card p-4 mt-4">
            <h5>Fiyat Teklifi</h5>
            @if (Model.QuotedPrice.HasValue)
            {
                <div class="small mb-3">Müşteri yanıtı: <strong>@Model.CustomerResponse.Label()</strong>@(Model.CustomerRespondedAt.HasValue ? " · " + Model.CustomerRespondedAt.Value.ToTrString() : "")
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerResponseNote)) { <div class="mt-1">“@Model.CustomerResponseNote”</div> }
                </div>
            }
            <form asp-action="Offer" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="QuotedPrice">Net Fiyat (₺)</label>
                        <input class="form-control" id="QuotedPrice" name="QuotedPrice" type="number" step="0.01" min="0" required value="@(Model.QuotedPrice.HasValue ? Model.QuotedPrice.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="EstimatedDeliveryDate">Tahmini Teslim Tarihi</label>
                        <input class="form-control" id="EstimatedDeliveryDate" name="EstimatedDeliveryDate" type="date" value="@Model.EstimatedDeliveryDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="WorkshopNote">Atölye Notu / Mesaj (müşteri görür)</label>
                        <textarea class="form-control" id="WorkshopNote" name="WorkshopNote" rows="3" maxlength="1000">@Model.WorkshopNote</textarea>
                    </div>
                </div>
                <button class="btn btn-wood mt-3" type="submit">@(Model.QuotedPrice.HasValue ? "Teklifi Güncelle" : "Teklifi Gönder")</button>
            </form>
        </div>

        <div class="wood-card p-4 mt-4">
            <h5>Aşama Güncellemesi / Atölye Fotoğrafı</h5>
            <form asp-action="AddProgress" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="pg-status">Aşama</label>
                        <select class="form-select" id="pg-status" name="Status">
                            @foreach (var s in Enum.GetValues<QuoteStatus>())
                            {
                                <option value="@((int)s)" selected="@(s == Model.Status)">@s.Icon() @s.Label()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label" for="pg-image">Fotoğraf (isteğe bağlı)</label>
                        <input class="form-control" id="pg-image" name="Image" type="file" accept="image/jpeg,image/png,image/webp" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="pg-note">Not (müşteri görür)</label>
                        <input class="form-control" id="pg-note" name="Note" maxlength="500" placeholder="Örn. Kesim tamamlandı, cila aşamasına geçiliyor." />
                    </div>
                </div>
                <button class="btn btn-dark-wood mt-3" type="submit">Ekle</button>
            </form>
        </div>

        @if (Model.History.Any())
        {
            <div class="wood-card p-4 mt-4">
                <h5>Süreç Geçmişi</h5>
                <ul class="list-unstyled mb-0">
                    @foreach (var h in Model.History.OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id))
                    {
                        <li class="border-start border-2 ps-3 pb-3">
                            <div class="small text-muted">@h.CreatedAt.ToTrString() · @h.Status.Icon() @h.Status.Label() · @h.ChangedBy</div>
                            @if (!string.IsNullOrWhiteSpace(h.Note)) { <div>@h.Note</div> }
                            @if (!string.IsNullOrEmpty(h.ImageUrl))
                            {
                                <a href="@h.ImageUrl" target="_blank" rel="noopener"><img src="@h.ImageUrl" alt="Atölye fotoğrafı" loading="lazy" class="mt-1" style="max-width:220px;border-radius:8px" /></a>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
    <div class="col-lg-5">
        <div class="wood-card p-4 mb-3">
            <h5>Müşteri</h5>
            <div>@Model.User?.FullName</div>
            <div class="small text-muted">@Model.User?.Email</div>
            <div class="small text-muted">@(Model.User?.Phone ?? "Telefon yok")</div>
        </div>
        <div class="ai-box">
            <div class="fw-semibold mb-2">Ön Analiz</div>
            @if (Model.AiCategory is null)
            {
                <div class="small text-muted">Analiz yok.</div>
            }
            else
            {
                <div class="small">Kategori: <strong>@Model.AiCategory</strong></div>
                <div class="small">Öncelik: <strong class="@(Model.AiPriority == "Yüksek" ? "text-danger" : "")">@Model.AiPriority</strong></div>
                <div class="small">Tahmini süre: <strong>≈ @Model.AiEstimatedDays iş günü</strong></div>
                <p class="small mt-2 mb-2">@Model.AiSummary</p>
                @foreach (var k in (Model.AiKeywords ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span class="ai-chip">@k</span>
                }
            }
            <form asp-action="Reanalyze" asp-route-id="@Model.Id" method="post" class="mt-3">
                <button class="btn btn-sm btn-outline-wood">Analizi Yenile</button>
            </form>
        </div>
    </div>
</div>
