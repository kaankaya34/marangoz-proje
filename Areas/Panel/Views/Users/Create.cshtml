@model UserCreateViewModel
@{
    ViewData["Title"] = "Kullanıcı Ekle";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<h1 class="mb-3">Kullanıcı Ekle</h1>
<div class="wood-card p-4" style="max-width: 600px">
    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" type="tel" inputmode="tel" maxlength="20" placeholder="05XX XXX XX XX" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Role" class="form-label"></label>
            @if (isAdmin)
            {
                <select asp-for="Role" class="form-select">
                    <option value="@Roles.Customer">Müşteri</option>
                    <option value="@Roles.Manager">Yönetici</option>
                    <option value="@Roles.Admin">Admin</option>
                </select>
            }
            else
            {
                <input class="form-control" value="Müşteri" disabled />
                <div class="form-text">Yöneticiler yalnızca müşteri hesabı ekleyebilir.</div>
            }
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>
        <button class="btn btn-wood" type="submit">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-wood">Vazgeç</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
