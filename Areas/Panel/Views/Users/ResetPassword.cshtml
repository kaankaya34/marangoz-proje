@model PasswordResetViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}
<h1 class="mb-3">Şifre Sıfırla</h1>
<div class="wood-card p-4" style="max-width: 600px">
    <p><strong>@Model.FullName</strong> için yeni bir şifre belirleyin.</p>
    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-4">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <button class="btn btn-wood" type="submit">Şifreyi Güncelle</button>
        <a asp-action="Index" class="btn btn-outline-wood">Vazgeç</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
