@model ProfileEditViewModel
@{
    ViewData["Title"] = "Profili Düzenle";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="wood-card p-4 p-md-5">
                <h2 class="mb-3">Profili Düzenle</h2>
                <form asp-action="EditProfile" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" type="tel" inputmode="tel" maxlength="20" placeholder="05XX XXX XX XX" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-wood">Kaydet</button>
                    <a asp-action="Profile" class="btn btn-outline-wood">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
