@model RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="wood-card p-4 p-md-5">
                <h2 class="mb-1">Kayıt Ol</h2>
                <p class="text-muted">Sipariş telefonunu görmek ve teklif talebi oluşturmak için üye olun.</p>
                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" type="tel" inputmode="tel" maxlength="20" placeholder="05XX XXX XX XX" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="AcceptKvkk" class="form-check-input" />
                            <label asp-for="AcceptKvkk" class="form-check-label small">
                                <a asp-controller="Pages" asp-action="Kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>'ni okudum, kişisel verilerimin işlenmesini kabul ediyorum.
                            </label>
                        </div>
                        <span asp-validation-for="AcceptKvkk" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-wood w-100 btn-lg">Kayıt Ol</button>
                </form>
                <p class="mt-3 mb-0 text-center small">Zaten üye misiniz? <a asp-action="Login">Giriş yapın</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
