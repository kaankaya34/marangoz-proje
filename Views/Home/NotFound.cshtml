@{
    int code = ViewBag.Code is int c ? c : 404;
    var notFound = code == 404;
    ViewData["Title"] = notFound ? "Sayfa bulunamadı" : "Hata";
}
<div class="container py-5 text-center">
    <p class="display-1 fw-bold text-muted mb-0">@code</p>
    <h1>@(notFound ? "Aradığınız sayfa bulunamadı" : "İsteğiniz işlenemedi")</h1>
    <p class="text-muted">@(notFound ? "Adres yanlış yazılmış olabilir ya da sayfa kaldırılmış olabilir." : "Lütfen daha sonra tekrar deneyin.")</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-wood me-2">Ana Sayfaya Dön</a>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-wood">Ürünlere Göz At</a>
</div>
