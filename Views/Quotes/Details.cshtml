@model QuoteRequest
@{
    ViewData["Title"] = $"Talep #{Model.Id}";
}
<div class="container py-4">
    <a asp-controller="Account" asp-action="Profile" class="small">← Taleplerime dön</a>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-2 mb-3">
        <div>
            <h1 class="mb-1">#@Model.Id · @Model.Title</h1>
            <div class="text-muted small">Oluşturulma: @Model.CreatedAt.ToTrString()@(Model.UpdatedAt.HasValue ? " · Son güncelleme: " + Model.UpdatedAt.Value.ToTrString() : "")</div>
        </div>
        <partial name="_StatusBadge" model="Model.Status" />
    </div>

    @if (Model.Status != QuoteStatus.Cancelled)
    {
        <div class="tracker mb-4">
            @foreach (var s in new[] { QuoteStatus.Pending, QuoteStatus.Surveyed, QuoteStatus.InProduction, QuoteStatus.Finishing, QuoteStatus.Completed })
            {
                <div class="step @(s == Model.Status ? "current" : (s < Model.Status ? "done" : ""))">@s.Icon() @s.Label()</div>
            }
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="wood-card p-4">
                <h5>Talep Detayı</h5>
                <p style="white-space: pre-line">@Model.Description</p>
                <dl class="row mb-0">
                    @if (Model.Product is not null) { <dt class="col-sm-4">İlgili Ürün</dt><dd class="col-sm-8"><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">@Model.Product.Name</a></dd> }
                    @if (!string.IsNullOrWhiteSpace(Model.CustomDimensions)) { <dt class="col-sm-4">İstenen Ölçüler</dt><dd class="col-sm-8">@Model.CustomDimensions</dd> }
                    @if (Model.Budget.HasValue) { <dt class="col-sm-4">Tahmini Bütçe</dt><dd class="col-sm-8">@Model.Budget.Value.ToString("N0") ₺</dd> }
                </dl>
            </div>

            @if (Model.Attachments.Any())
            {
                <div class="wood-card p-4 mt-4">
                    <h5>Yüklediğiniz Fotoğraflar</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var a in Model.Attachments)
                        {
                            <a href="@a.Url" target="_blank" rel="noopener"><img src="@a.Url" alt="Referans fotoğraf" loading="lazy" style="width:110px;height:110px;object-fit:cover;border-radius:8px" /></a>
                        }
                    </div>
                </div>
            }

            @if (Model.QuotedPrice.HasValue)
            {
                var canRespond = Model.UserId == User.GetUserId() && Model.Status is not (QuoteStatus.Completed or QuoteStatus.Cancelled);
                <div class="wood-card p-4 mt-4">
                    <h5>Atölye Teklifi</h5>
                    <div class="price fs-3">@Model.QuotedPrice.Value.ToString("N0") ₺</div>
                    @if (Model.EstimatedDeliveryDate.HasValue)
                    {
                        <div class="small">Tahmini teslim: <strong>@Model.EstimatedDeliveryDate.Value.ToString("dd.MM.yyyy")</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.WorkshopNote))
                    {
                        <p class="mt-2 mb-2" style="white-space: pre-line">@Model.WorkshopNote</p>
                    }
                    <div class="small text-muted mb-3">Durum: @Model.CustomerResponse.Label()@(Model.CustomerRespondedAt.HasValue ? " · " + Model.CustomerRespondedAt.Value.ToTrString() : "")</div>

                    @if (canRespond)
                    {
                        <form asp-action="Respond" asp-route-id="@Model.Id" method="post">
                            <label class="form-label small" for="resp-note">Notunuz (isteğe bağlı)</label>
                            <textarea id="resp-note" name="note" class="form-control mb-3" rows="2" maxlength="500" placeholder="Revize isteğinizi veya notunuzu yazın."></textarea>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="response" value="@((int)CustomerResponse.Approved)" class="btn btn-wood" type="submit">Onayla</button>
                                <button name="response" value="@((int)CustomerResponse.RevisionRequested)" class="btn btn-outline-wood" type="submit">Revize İste</button>
                                <button name="response" value="@((int)CustomerResponse.Rejected)" class="btn btn-outline-danger" type="submit" formnovalidate data-confirm="Teklifi reddederseniz talep iptal edilir. Emin misiniz?">Reddet</button>
                            </div>
                        </form>
                    }
                </div>
            }

            @if (Model.History.Any())
            {
                <div class="wood-card p-4 mt-4">
                    <h5>Süreç Geçmişi</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var h in Model.History.OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id))
                        {
                            <li class="border-start border-2 ps-3 pb-3">
                                <div class="small text-muted">@h.CreatedAt.ToTrString() · @h.Status.Icon() @h.Status.Label()</div>
                                @if (!string.IsNullOrWhiteSpace(h.Note)) { <div>@h.Note</div> }
                                @if (!string.IsNullOrEmpty(h.ImageUrl))
                                {
                                    <a href="@h.ImageUrl" target="_blank" rel="noopener"><img src="@h.ImageUrl" alt="Atölye fotoğrafı" loading="lazy" class="mt-1" style="max-width:220px;border-radius:8px" /></a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
        <div class="col-lg-4">
            @if (!string.IsNullOrEmpty(Model.AiCategory))
            {
                <div class="ai-box">
                    <div class="fw-semibold mb-2"><svg class="i"><use href="#i-leaf" /></svg> Ön Değerlendirme</div>
                    <div class="small">Kategori: <strong>@Model.AiCategory</strong></div>
                    <div class="small">Tahmini üretim süresi: <strong>≈ @Model.AiEstimatedDays iş günü</strong></div>
                    <div class="small text-muted mt-2">Bu değerler tahminidir; kesin teklif ve süre keşif sonrası bildirilir.</div>
                </div>
            }
            @if (Model.UserId == User.GetUserId() && Model.Status == QuoteStatus.Pending && Model.CustomerResponse != CustomerResponse.Approved)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="Talebi iptal etmek istediğinize emin misiniz?">
                    <button type="submit" class="btn btn-outline-danger w-100">Talebi İptal Et</button>
                </form>
            }
        </div>
    </div>
</div>
