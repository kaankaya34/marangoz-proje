@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}
<div class="container py-5 text-center">
    <h1>Bir şeyler ters gitti</h1>
    <p class="text-muted">İsteğiniz işlenirken bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">İstek Kimliği: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-wood">Ana Sayfaya Dön</a>
</div>
