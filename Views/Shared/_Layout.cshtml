@{
    var site = SiteOpt.Value;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isStaff = User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Admin);
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var pageTitle = ViewData["Title"] as string ?? site.Name;
    var ogTitle = ViewData["OgTitle"] as string ?? pageTitle;
    var ogDescription = ViewData["OgDescription"] as string ?? "El yapımı, özel ölçü ahşap mobilya: masa, sandalye, tabure ve sallanan sandalye.";
    var ogImage = ViewData["OgImage"] as string;
    if (!string.IsNullOrEmpty(ogImage) && ogImage.StartsWith('/')) { ogImage = $"{Context.Request.Scheme}://{Context.Request.Host}{ogImage}"; }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@site.Name</title>
    <meta name="description" content="@ogDescription" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="@site.Name" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.classList.add('js');</script>
</head>
<body>
    <svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></symbol>
            <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></symbol>
            <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></symbol>
            <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
            <symbol id="i-insta" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" /></symbol>
            <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></symbol>
            <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></symbol>
            <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M5 19C5 10 11 4 20 4c0 9-6 15-15 15z" /><path d="M5 19l8-8" /></symbol>
            <symbol id="i-tree" viewBox="0 0 24 24"><path d="M12 21v-7" /><path d="M12 14c-4 0-7-2.5-7-6 0-2.5 2-4.5 4-4.5 0-1.7 1.5-3 3-3s3 1.3 3 3c2 0 4 2 4 4.5 0 3.5-3 6-7 6z" /><path d="M12 14l-3-3M12 12l3-3" /></symbol>
            <symbol id="i-table" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="3" rx="1" /><path d="M5 10v10M19 10v10M8 10v5M16 10v5" /></symbol>
            <symbol id="i-chair" viewBox="0 0 24 24"><path d="M7 3h10v9H7zM5 12h14v3H5zM7 15v6M17 15v6" /></symbol>
            <symbol id="i-stool" viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="3" rx="1.5" /><path d="M8 10l-2 11M16 10l2 11M7.3 16h9.4" /></symbol>
            <symbol id="i-rocker" viewBox="0 0 24 24"><path d="M6 3l2 11h9M8 8h7M9 14v4M16 14v4M3 20q9 4 18 0" /></symbol>
            <symbol id="i-hand" viewBox="0 0 24 24"><path d="M7 11V5a1.5 1.5 0 0 1 3 0v5M10 10V3.5a1.5 1.5 0 0 1 3 0V10M13 10V5a1.5 1.5 0 0 1 3 0v6M16 11V8.5a1.5 1.5 0 0 1 3 0V15a7 7 0 0 1-7 7h-1a6 6 0 0 1-5-3l-2.5-4a1.5 1.5 0 0 1 2.4-1.7L7 14" /></symbol>
            <symbol id="i-ruler" viewBox="0 0 24 24"><rect x="2" y="8" width="20" height="8" rx="1.5" /><path d="M6 8v3M10 8v4M14 8v3M18 8v4" /></symbol>
            <symbol id="i-track" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><path d="M9 10l2 2 4-4" /></symbol>
            <symbol id="i-up" viewBox="0 0 24 24"><path d="M6 15l6-6 6 6" /></symbol>
        </defs>
    </svg>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <div class="topbar py-1">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-1">
            <span><svg class="i"><use href="#i-leaf" /></svg> El yapımı, özel ölçü ahşap mobilya</span>
            @if (isAuth)
            {
                <span><svg class="i"><use href="#i-phone" /></svg> Sipariş Hattı: <a href="tel:@(site.OrderPhone.Replace(" ", ""))"><strong>@site.OrderPhone</strong></a></span>
            }
            else
            {
                <span><svg class="i"><use href="#i-phone" /></svg> Sipariş telefonunu görmek için <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">giriş yapın</a></span>
            }
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-xl site-nav">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><svg class="i brand-mark"><use href="#i-tree" /></svg> @site.Name</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0">
                        <li class="nav-item"><a class="nav-link @(ctrl == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link @(ctrl == "Products" ? "active" : "")" asp-area="" asp-controller="Products" asp-action="Index">Ürünler</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Quotes" asp-action="Create">Teklif İste</a></li>
                        @if (isAuth)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Profile" asp-fragment="tab-quotes">Taleplerim</a></li>
                        }
                        <li class="nav-item"><a class="nav-link @(ctrl == "Pages" ? "active" : "")" asp-area="" asp-controller="Pages" asp-action="About">Hakkımızda</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Pages" asp-action="WoodGuide">Ahşap Rehberi</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Pages" asp-action="Contact">İletişim</a></li>
                    </ul>
                    <form class="d-flex me-xl-3 mb-2 mb-xl-0" asp-area="" asp-controller="Products" asp-action="Index" method="get" role="search">
                        <input class="form-control form-control-sm me-2" type="search" name="q" placeholder="Ürün ara..." aria-label="Ara" />
                        <button class="btn btn-sm btn-dark-wood" type="submit">Ara</button>
                    </form>
                    <ul class="navbar-nav">
                        @if (isAuth)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><svg class="i"><use href="#i-user" /></svg> @User.Identity!.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile" asp-fragment="tab-info">Profilim</a></li>
                                    @if (isStaff)
                                    {
                                        <li><a class="dropdown-item" asp-area="Panel" asp-controller="Dashboard" asp-action="Index">Yönetim Paneli</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                            <li class="nav-item ms-xl-2"><a class="btn btn-wood btn-sm mt-1" asp-area="" asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="container mt-3">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="site-footer py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5>@site.Name</h5>
                    <p class="mb-0">Masa, sandalye, tabure ve sallanan sandalye gibi özel ölçü ahşap ürünleri, kendi atölyemizde sizin için üretiyoruz.</p>
                </div>
                <div class="col-md-3">
                    <h5>Bağlantılar</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-area="" asp-controller="Products" asp-action="Index">Ürünler</a></li>
                        <li><a asp-area="" asp-controller="Quotes" asp-action="Create">Özel Ölçü Teklifi</a></li>
                        <li><a asp-area="" asp-controller="Pages" asp-action="About">Hakkımızda</a></li>
                        <li><a asp-area="" asp-controller="Pages" asp-action="WoodGuide">Ahşap ve Cila Rehberi</a></li>
                        <li><a asp-area="" asp-controller="Pages" asp-action="Faq">Sık Sorulan Sorular</a></li>
                        <li><a asp-area="" asp-controller="Pages" asp-action="Contact">İletişim</a></li>
                        <li><a asp-area="" asp-controller="Pages" asp-action="Kvkk">KVKK Aydınlatma Metni</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>İletişim</h5>
                    <p class="mb-1"><svg class="i"><use href="#i-pin" /></svg> @site.Address</p>
                    <p class="mb-1"><svg class="i"><use href="#i-mail" /></svg> @site.Email</p>
                    @if (!string.IsNullOrWhiteSpace(site.WorkingHours))
                    {
                        <p class="mb-1"><svg class="i"><use href="#i-clock" /></svg> @site.WorkingHours</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.Instagram))
                    {
                        <p class="mb-1"><svg class="i"><use href="#i-insta" /></svg> <a href="@site.Instagram" target="_blank" rel="noopener noreferrer">Instagram</a></p>
                    }
                    @if (isAuth)
                    {
                        <p class="mb-0"><svg class="i"><use href="#i-phone" /></svg> @site.OrderPhone</p>
                    }
                    else
                    {
                        <p class="mb-0"><svg class="i"><use href="#i-phone" /></svg> <a asp-area="" asp-controller="Account" asp-action="Login">Giriş yapınca görünür</a></p>
                    }
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <small>&copy; @DateTime.Now.Year @site.Name. Tüm hakları saklıdır.</small>
        </div>
    </footer>

    <button type="button" class="back-top" id="back-top" aria-label="Yukarı çık"><svg class="i"><use href="#i-up" /></svg></button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
