@model (int Page, int TotalPages, Func<int, string?> Url)
@if (Model.TotalPages > 1)
{
    // Geçerli sayfanın 2 yanı + ilk/son sayfa; aradaki boşluklar "…" ile gösterilir.
    var pages = Enumerable.Range(1, Model.TotalPages)
        .Where(i => i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
        .ToList();
    <nav aria-label="Sayfalama" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Model.Url(Model.Page - 1)" aria-label="Önceki">‹</a></li>
            @for (var k = 0; k < pages.Count; k++)
            {
                var i = pages[k];
                if (k > 0 && i - pages[k - 1] > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Model.Url(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.Url(Model.Page + 1)" aria-label="Sonraki">›</a></li>
        </ul>
    </nav>
}
